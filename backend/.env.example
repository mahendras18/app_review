# Backend Configuration
HOST=127.0.0.1
PORT=8000
DEFAULT_COUNTRY=in
DEFAULT_REVIEW_COUNT=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_TIMEOUT_SECONDS=15

# Temporary Online Excel Report Hosting
# Optional: Set PUBLIC_BASE_URL to your publicly accessible HTTPS domain or tunnel
# (e.g. https://my-deployed-backend.com or https://xyz.ngrok-free.app)
# Microsoft's Excel Online Viewer requires a publicly accessible HTTPS URL to fetch workbooks.
PUBLIC_BASE_URL=
REPORT_RETENTION_HOURS=24
# Storage directory for generated reports (set to /var/data/reports on Render)
REPORT_STORAGE_DIR=
